# secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# deps / build
tools/scraperai/.venv/
__pycache__/
node_modules/
.next/
dist/
build/
.vercel/

# os / editor noise
.DS_Store
*.log
tmp/

# codegraph local index (rebuilt per machine)
.codegraph/

# scratch
_probe_*

# Scraped pages and harvest output — regenerate with the tools in
# tools/scraperai/. The watermark (state.json) and the counts (summary.json) ARE
# tracked: they are what a scheduled run reads to know where it got to, and a
# machine that lacks them redoes a full pass for nothing.
tools/scraperai/.cache/
data/*/*.ndjson

# Obsidian per-user state (shared config stays tracked)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Graphify output (regenerated locally, optional)
graphify-out/

# operator handover notes — local only, not for the public/team repo
HANDOVER.md
.vercel
