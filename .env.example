# Shared team test keys — scaffold.sh copies this file to app/.env.local.
# The Supabase URL + anon key are public by design (RLS protects the data) — they can live in the repo.
# NEVER put secrets here: the Supabase service_role key, the Vercel token, private API keys.

# Supabase — the team's shared "codex-hackathon" project (already created)
NEXT_PUBLIC_SUPABASE_URL=https://quvxxqxowathrcyshhwj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF1dnh4cXhvd2F0aHJjeXNoaHdqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ1NjM2OTMsImV4cCI6MjEwMDEzOTY5M30.1_qVpOJ9ohil-qrkwHvWHTVPAlAwcZDJ3F96SlUFSQg

# OpenAI — everyone uses their own key (the event provides $150 in API credits); fill it in on first use
OPENAI_API_KEY=sk-YOUR-KEY
OPENAI_MODEL=gpt-5-nano
# Optional override for web-assisted location research
OPENAI_SEARCH_MODEL=gpt-5-nano
# Optional override for location-to-scene visual matching
OPENAI_VISION_MODEL=gpt-5-nano
# Optional separate HMAC secret; OPENAI_API_KEY is used when this is unset
# SCENE_MATCH_SIGNING_SECRET=GENERATE-A-LONG-RANDOM-VALUE
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# TMDB — server-only token for movie stills; add it to your local .env.local and the Vercel Environment Variables
# TMDB_API_READ_ACCESS_TOKEN=YOUR-TMDB-API-READ-ACCESS-TOKEN

# Server-only, do NOT commit: the Supabase service_role key (needed only for privileged operations)
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY  (get it from the Supabase dashboard, keep it out of the repo)
