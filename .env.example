# Copy this to .env.local (Next.js) or .env, fill in, and NEVER commit the filled copy.
# .env / .env.* are gitignored. Every value here is a placeholder.

# Supabase — from your project's API settings (app.supabase.com -> Project -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-side only (never prefix with NEXT_PUBLIC_): service role key for privileged ops
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# OpenAI — the event gives you $50 of API credit; use it for in-app LLM calls
OPENAI_API_KEY=sk-YOUR-KEY
